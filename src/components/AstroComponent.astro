---
<div id="arcade-boot-screen" class="boot-screen">
  <div class="boot-content">
    <p class="sys-text">SYS_INIT: MEMORY CHECK...</p>
    <p class="sys-text delay-1">640K OK</p>
    <p class="sys-text delay-2">LOADING 'FROM PIXELS TO POLYGONS' OS v1.0...</p>
    <p class="sys-text delay-3">MOUNTING GITHUB REPOSITORY...</p>
    <h2 class="insert-coin delay-4">INSERT COIN</h2>
  </div>
</div>

<style>
  .boot-screen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: #000;
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  .boot-content {
    text-align: left;
    font-family: 'VT323', monospace;
    font-size: 2rem;
    color: #0f0;
    width: 80%;
    max-width: 600px;
  }

  .sys-text {
    margin-bottom: 10px;
    opacity: 0;
    animation: typeIn 0.1s forwards;
  }

  .insert-coin {
    font-family: 'Press Start 2P', cursive;
    color: #ffea00;
    text-align: center;
    margin-top: 3rem;
    font-size: 1.5rem;
    opacity: 0;
    animation: blinkCoin 1s infinite alternate;
  }

  .delay-1 { animation-delay: 0.8s; }
  .delay-2 { animation-delay: 1.5s; }
  .delay-3 { animation-delay: 2.2s; }
  .delay-4 { animation-delay: 3s; }

  @keyframes typeIn {
    0% { opacity: 0; transform: translateX(-10px); }
    100% { opacity: 1; transform: translateX(0); }
  }

  @keyframes blinkCoin {
    0% { opacity: 0; }
    100% { opacity: 1; text-shadow: 0 0 15px #ffea00; }
  }

  .boot-hidden {
    opacity: 0;
    pointer-events: none;
    transform: scale(1.05);
  }
</style>

<script>
  window.addEventListener('DOMContentLoaded', () => {
    const bootScreen = document.getElementById('arcade-boot-screen');
    if (bootScreen) {
      setTimeout(() => {
        bootScreen.classList.add('boot-hidden');
        setTimeout(() => {
          bootScreen.remove();
        }, 800);
      }, 4500);
    }
  });
</script>